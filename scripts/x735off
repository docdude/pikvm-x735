#!/bin/bash
set -Eeuo pipefail

I2S_DEV=fe203000.i2s
I2S_DRIVER=/sys/bus/platform/drivers/bcm2835-i2s
CHIP=/dev/gpiochip0

restore_audio() {
    if [ ! -L "$I2S_DRIVER/$I2S_DEV" ]; then
        echo "$I2S_DEV" > "$I2S_DRIVER/bind" || true
    fi
}
trap restore_audio EXIT

# Only proceed when the active power daemon will answer the X735's shutdown
# pulse; otherwise the board would assert GPIO5 with nobody to respond.
daemon=
for unit in x735-button x735-pwr; do
    if systemctl is-active --quiet "$unit"; then
        daemon=$unit
        break
    fi
done
if [ -z "$daemon" ]; then
    echo "ERROR: no X735 power daemon (x735-button or x735-pwr) is active"
    exit 1
fi

env=$(systemctl show "$daemon" -p Environment --value)
if [[ " $env " != *" X735_ACTION=live "* ]]; then
    echo "ERROR: $daemon is not in live mode"
    exit 1
fi

echo "Syncing filesystems..."
sync

echo "Releasing HDMI audio I2S pins..."
if [ -L "$I2S_DRIVER/$I2S_DEV" ]; then
    echo "$I2S_DEV" > "$I2S_DRIVER/unbind"
fi

# Verify that GPIO20 is no longer owned by I2S.
pin20=$(grep 'pin 20 ' /sys/kernel/debug/pinctrl/*/pinmux-pins || true)
if [[ -z $pin20 ]]; then
    echo "ERROR: cannot read GPIO20 pinmux (is debugfs mounted?)"
    exit 1
fi
if [[ $pin20 == *fe203000.i2s* ]]; then
    echo "ERROR: GPIO20 still owned by I2S"
    echo "$I2S_DEV" > "$I2S_DRIVER/bind" || true
    exit 1
fi

echo "Requesting X735 software shutdown..."

# Hold GPIO20 high for four seconds, then return it low.
gpioset -c "$CHIP" -t 4s,0 20=1

# If the Pi is still running, restore HDMI audio.
if [ ! -L "$I2S_DRIVER/$I2S_DEV" ]; then
    echo "$I2S_DEV" > "$I2S_DRIVER/bind" || true
fi
