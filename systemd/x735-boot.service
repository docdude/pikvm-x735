[Unit]
Description=Geekworm X735 BOOT handshake (GPIO12 held high while running)
# No Conflicts=shutdown.target: systemd does not stop this unit during
# shutdown, so gpioset is only killed in the final stage and GPIO12 stays
# high until just before power-off or reboot.
DefaultDependencies=no
After=sysinit.target

[Service]
Type=simple
ExecStart=/usr/local/bin/x735-boot.sh
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
